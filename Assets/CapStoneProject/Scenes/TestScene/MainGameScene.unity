      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 2064762208773221700, guid: 1126951403d3bfb4c9003355cceaa73d, type: 3}
      propertyPath: dialogueLines.Array.data[0]
      value: "\uC544\uAE4C \uB4E4\uC5B4\uAC04 \uACE0\uACE0\uD559\uC790\uB294 \uAC19\uC774
        \uC548\uC654\uB098?"
      objectReference: {fileID: 0}
    - target: {fileID: 2064762208773221700, guid: 1126951403d3bfb4c9003355cceaa73d, type: 3}
      propertyPath: dialogueLines.Array.data[1]
      value: "\uC720\uBB3C\uC774 \uBC1C\uB3D9\uB418\uBA74\uC11C \uC9C0\uC9C4\uC774
        \uBC1C\uC0DD\uD55C \uAC83 \uAC19\uC544! "
      objectReference: {fileID: 0}
    - target: {fileID: 2064762208773221700, guid: 1126951403d3bfb4c9003355cceaa73d, type: 3}
      propertyPath: dialogueLines.Array.data[2]
      value: "\uC6B0\uB9AC\uAC00 \uB4E4\uC5B4\uC628 \uAE38\uC740 \uC9C0\uC9C4\uC73C\uB85C
        \uBB34\uB108\uC838 \uBC84\uB838\uC5B4!"
      objectReference: {fileID: 0}
    - target: {fileID: 2064762208773221700, guid: 1126951403d3bfb4c9003355cceaa73d, type: 3}
      propertyPath: dialogueLines.Array.data[3]
      value: "\uB300\uC2E0 \uC6D0\uB798 \uB9C9\uD600\uC788\uB358 \uBB18\uC9C0\uB85C
        \uAC00\uB294\uAE38\uC774 \uC5F4\uB838\uB124 \uBB18\uC9C0 \uAC74\uB108\uD3B8\uC5D4
        \uB9C8\uC744\uB85C\uAC00\uB294 \uC9C0\uB984\uAE38\uC774 \uC788\uC5B4!\n\uC77C\uB2E8
        \uC774\uB9AC\uB85C \uAC00\uB294 \uC218 \uBC16\uC5D0 \uC5C6\uB124"
      objectReference: {fileID: 0}
    - target: {fileID: 2064762208773221700, guid: 1126951403d3bfb4c9003355cceaa73d, type: 3}
      propertyPath: dialogueLines.Array.data[4]
      value: "\uC624\uB7AC\uB3D9\uC548 \uB9C9\uD600\uC788\uB358 \uAE38\uC774\uB77C
        \uBB50\uAC00 \uB098\uC62C\uC9C0 \uBAA8\uB974\uB124 \uC870\uC2EC\uD574\uC57C
        \uD574!"
      objectReference: {fileID: 0}
    - target: {fileID: 2064762208773221700, guid: 1126951403d3bfb4c9003355cceaa73d, type: 3}
      propertyPath: dialogueLines.Array.data[5]
