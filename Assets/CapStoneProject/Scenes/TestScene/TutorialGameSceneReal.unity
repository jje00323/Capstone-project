  npcID: end_tutorial
  dialogueLines:
  - "\"\uADF8 \uD53C\uC640 \uD63C\uC744 \uBC14\uCCD0, \uBD09\uC778\uC744 \uD47C \uC790\uC5EC
    \uADF8\uB300\uC758 \uB05D\uC740 \uACE7 \uC2DC\uC791\uC774\uB2C8\uB77C\"\"\r"
  - "\"\uC5EC\uAE30\uC5D0 \uC7A0\uB4E0 \uD63C\uC740 \uC8FD\uC74C\uC744 \uBA39\uACE0
    \uB208\uC744 \uB728\uB9AC\uB77C \uACFC\uAC70\uC758 \uCE7C\uB0A0\uC740 \uB2E4\uC2DC\uAE08
    \uBD88\uD0C0\uC624\uB974\uB9AC\uB2C8\""
  - "\"\uD55C \uC0DD\uBA85\uC758 \uD76C\uC0DD\uC73C\uB85C, \uD558\uB098\uC758 \uC6B4\uBA85\uC774
    \uB3CC\uC544\uC624\uB9AC\uB77C\""
  - "\uC720\uBB3C\uC774 \uAC15\uD558\uAC8C \uBE5B\uB098\uBA70 \uACF5\uAC04\uC774
    \uC77C\uADF8\uB7EC\uC9C0\uAE30 \uC2DC\uC791\uD588\uB2E4."
  npcName: "\"[\uC11D\uD310\uC5D0 \uC0C8\uACA8\uC9C4 \uAE00\uADC0]\""
