--- !u!114 &655018098
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 655018095}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ba766edcbfa9d7444be6762c1f215248, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcID: TUTORIAL_NPC
  dialogueLines:
  - "\"\uC774\uBD10, \uCC98\uC74C \uBCF4\uB294 \uC5BC\uAD74\uC778\uB370... \uB108\uB3C4
    \uADF8 \uC720\uBB3C \uCC3E\uC73C\uB7EC \uC628 \uAC74\uAC00?\""
  - "\"\uB09C \uC774 \uADFC\uCC98\uB97C \uC624\uB7AB\uB3D9\uC548 \uC9C0\uCF1C\uC628
    \uC0AC\uB0E5\uAFBC \uB808\uC628\uC774\uC57C.\n\uADF8 \uC232 \uC548\uC740 \uB124\uAC00
    \uC0DD\uAC01\uD558\uB294 \uAC83\uBCF4\uB2E4 \uD6E8\uC52C \uC704\uD5D8\uD558\uC9C0.\n\uD2B9\uD788
    \uC694\uC998\uC740 \uC548\uCABD\uC5D0\uC11C \uC774\uC0C1\uD55C \uAE30\uC6B4\uC774
    \uAC10\uB3CC\uACE0 \uC788\uC5B4.\""
  - "\"\uB124\uAC00 \uACE0\uACE0\uD559\uC790\uB4E0 \uBB50\uB4E0 \uAC04\uC5D0, \uAC70\uAE30
    \uB4E4\uC5B4\uAC00\uB824\uBA74 \uAE30\uBCF8\uC740 \uC54C\uC544\uB46C\uC57C \uD574.\n\uC798
    \uB4E4\uC5B4. \uB0B4\uAC00 \uAC04\uB2E8\uD788 \uC54C\uB824\uC8FC\uC9C0.\""
  - "[\uB9C8\uC6B0\uC2A4 \uC6B0\uD074\uB9AD]\uC73C\uB85C \uC774\uB3D9\uD558\uACE0,
    \uB9C8\uC6B0\uC2A4 \uC88C\uD074\uB9AD\uC73C\uB85C \uAE30\uBCF8 \uACF5\uACA9\uC744
    \uD560 \uC218 \uC788\uC5B4."
  - "\"\uC801\uC744 \uC4F0\uB7EC\uB728\uB9AC\uBA74 \uACBD\uD5D8\uCE58\uB97C \uC5BB\uAC8C
    \uB3FC.\n\uB808\uBCA8\uC774 \uC624\uB974\uBA74 \uC2A4\uD0AC \uD3EC\uC778\uD2B8\uAC00
    \uC0DD\uAE30\uACE0, [K \uD0A4]\uB97C \uB20C\uB7EC \uC2A4\uD0AC\uC744 \uBC30\uC6B8
    \uC218 \uC788\uC9C0.\""
  - "\"\uC544\uC774\uD15C\uC740 \uC0C1\uC790\uB098 \uC801\uC774 \uB4DC\uB86D\uD558\uB294
    \uAC78 \uC8FC\uC6CC\uC11C [I \uD0A4]\uB85C \uD655\uC778\uD560 \uC218 \uC788\uC5B4.\n\uD3EC\uC158
    \uAC19\uC740 \uAC74 \uB354\uBE14\uD074\uB9AD\uD558\uAC70\uB098 \uD035\uC2AC\uB86F\uC5D0
    \uB4F1\uB85D\uD574\uC11C \uC0AC\uC6A9\uD558\uBA74 \uB3FC.\""
  - "\uBB34\uC5C7\uC744 \uD574\uC57C\uD560\uC9C0 \uBAA8\uB974\uACA0\uB2E4\uBA74 [Q\uD0A4]\uB97C
